{
  "name": "@nsea/depseeker",
  "version": "0.0.5",
  "description": "A TypeScript library for analyzing project file dependencies with support for TS path aliases, ES modules, CommonJS, and dynamic imports",
  "keywords": [
    "dependency",
    "analyzer",
    "parser",
    "typescript",
    "ast",
    "import",
    "module",
    "graph"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.2.1",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/NorthSeacoder/depseeker#readme",
  "bugs": {
    "url": "https://github.com/NorthSeacoder/depseeker/issues"
  },
  "author": "NorthSeacoder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorthSeacoder/depseeker.git"
  },
  "license": "WTFPL",
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "devDependencies": {
    "@antfu/ni": "^27.0.1",
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^24.10.0",
    "@eslint/js": "^9.19.0",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "bumpp": "^10.3.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "fast-glob": "^3.3.3",
    "tsconfig-paths": "^4.2.0"
  },
  "sideEffects": false,
  "scripts": {
    "cz": "git add . && git-cz",
    "clean": "rimraf dist coverage stats.html",
    "build": "pnpm run clean && tsup",
    "build:watch": "tsup --watch",
    "analyze": "pnpm run clean && tsup --metafile && esbuild-visualizer --metadata ./dist/metafile-*.json --open",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:eslint && pnpm run typecheck",
    "lint:eslint": "eslint \"{src,tests}/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-exports": "attw --pack .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run test",
    "ci": "pnpm run build && pnpm run check-exports && pnpm run check",
    "prepublishOnly": "pnpm run ci",
    "release": "bumpp && pnpm publish --access public"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
